<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.gnist.app</id>

  <name>Gnist</name>
  <summary>Minimal serial terminal</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      Gnist is a clean, modern serial terminal for communicating with
      microcontrollers, embedded systems, and other serial devices.
      It automatically detects connected ports and supports common baud rates.
    </p>
    <ul>
      <li>Auto-detects USB and ACM serial ports</li>
      <li>Configurable baud rate up to 115200</li>
      <li>Full terminal emulation via xterm.js</li>
      <li>Ports refreshed automatically when devices are plugged in or out</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.gnist.app.desktop</launchable>

  <screenshots>
